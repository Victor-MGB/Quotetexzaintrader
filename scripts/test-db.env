# Connection details for the throwaway Postgres that `npm run test:db:up` starts.
#
# This file is the single source of truth for the test database: the shell
# script sources it, and tests/helpers/config.ts parses it, so the two can
# never drift apart. The password below is a disposable local value for a
# container that only listens on 127.0.0.1 — it is not a credential.
QZT_TEST_DB_HOST=127.0.0.1
QZT_TEST_DB_PORT=55436
QZT_TEST_DB_NAME=qzt
QZT_TEST_DB_USER=postgres
QZT_TEST_DB_PASSWORD=qzt
QZT_TEST_DB_CONTAINER=qzt-test
QZT_TEST_DB_IMAGE=postgres:16
