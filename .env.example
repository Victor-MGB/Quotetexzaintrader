# Bot
BOT_TOKEN=your_telegram_bot_token
BOT_USERNAME=your_bot_username

# Run mode: "webhook" (production, fast) | "polling" (dev)
BOT_MODE=webhook
# Origin only. BOT_WEBHOOK_PATH is appended to it, so including /webhook here
# would register /webhook/webhook.
BOT_WEBHOOK_URL=https://example.com
BOT_WEBHOOK_PATH=/webhook
BOT_WEBHOOK_PORT=8080

# Testimony media storage (Supabase). Both are required for uploads to be
# durable; with either missing, a production bot refuses uploads rather than
# writing them to a disk the host will delete. Find both under
# Project Settings -> API. The key is a secret: never commit it.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# PostgreSQL (local) — Supabase: set DB_SSL=true and use the Supabase connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/quotex_zain
DB_SSL=false

# Redis (cache / rate limit)
REDIS_URL=redis://localhost:6379

# App
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated Telegram user IDs (numeric) who can manage the bot
# Logout session inactivity timeout (minutes)
SESSION_TIMEOUT_MINUTES=30
ADMIN_IDS=123456789

# Deposit addresses shown on the Deposit screen. Leave empty to hide that
# payment method (members are then told to ask an admin for the address).
# These take priority over anything saved with /setaddress.
# Accepted formats are validated: Bitcoin legacy/base58 or bech32 (bc1...),
# TRC20 and TRX base58 starting with T, Ethereum 0x followed by 40 hex chars.
DEPOSIT_BTC=
DEPOSIT_TRC20=
DEPOSIT_TRX=
DEPOSIT_ETH=